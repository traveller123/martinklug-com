---
import Base from './Base.astro';
import Signup from '../components/Signup.astro';
import { getEssays, readingTime } from '../lib/essays.mjs';

const { frontmatter } = Astro.props;
const url = (Astro.props.url || '').replace(/\.html$/, '');
const essays = getEssays();
const i = essays.findIndex((e) => e.url === url);
const current = essays[i] || { words: 0 };
// List order on the home page: `prev` is the essay above this one, `next` the one below.
const prev = i > 0 ? essays[i - 1] : null;
const next = i >= 0 && i < essays.length - 1 ? essays[i + 1] : null;
---
<Base title={frontmatter.title} description={frontmatter.summary} ogType="article">
  <article class="prose-wrap">
    <header class="essay-head">
      <p class="label">{frontmatter.category} · {readingTime(current.words)} min read</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.summary && <p class="dek">{frontmatter.summary}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>

  <aside class="prose-wrap author">
    <img src="/images/martin-klug-small.jpg" alt="" width="88" height="88">
    <p>I'm Martin Klug. I build companies, back founders, and invest in residential real estate in Germany. <a href="/#about">More about me</a>.</p>
  </aside>

  <section class="prose-wrap" style="margin-bottom: 48px;">
    <Signup boxed heading="Letters" />
  </section>

  {(prev || next) && (
    <nav class="prose-wrap pager" aria-label="More essays">
      {prev ? <a href={prev.url}><span class="label">← Previous</span>{prev.title}</a> : <span></span>}
      {next && <a class="next" href={next.url}><span class="label">Next →</span>{next.title}</a>}
    </nav>
  )}
</Base>
